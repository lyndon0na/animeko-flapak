#!/bin/sh
# Entry point for the Animeko Flatpak.
#
# Mirrors the AppImage's AppRun without exporting LD_LIBRARY_PATH: the jpackage
# launcher already appends its own app directory to LD_LIBRARY_PATH (which is
# what feeds java.library.path for libanitorrent, libmediampv and Skiko), and
# overwriting the value Flatpak sets up can break loading of runtime libraries.
set -eu

# The bundled CEF (Chrome 137) aborts its unzip utility process with
# "*** stack smashing detected ***" every time Chromium's component updater
# unpacks a component; CEF does not implement --change-stack-guard-on-fork, so
# the stack canary of the forked child does not match (CEF issue #3912). It is
# harmless - the updater retries and the components do install - but every
# SIGABRT writes a ~110 MB core dump and makes KDE's drkonqi pop a crash dialog.
# One component burst produced 24 dialogs and 2.6 GB of dumps in a minute.
#
# With no core file there is nothing for drkonqi to show, so both stop here. To
# keep cores while debugging, e.g.:
#   flatpak run --env=ANIMEKO_FLATPAK_KEEP_CORES=1 me.him188.ani
if [ "${ANIMEKO_FLATPAK_KEEP_CORES:-0}" != "1" ]; then
    ulimit -c 0
fi

APPDIR=/app/ani
export APPDIR
export PATH="$APPDIR/usr/bin:$PATH"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

exec "$APPDIR/usr/bin/Ani" "$@"
